{
  "manifest_version": 3,
  "name": "Midas",
  "version": "0.18.0",
  "description": "__MSG_appDesc__",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.duolingo.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Midas",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.duolingo.com/*"
      ],
      "js": [
        "src/i18n.js",
        "src/changelog/pt.js",
        "src/changelog/en.js",
        "src/changelog/es.js",
        "src/main.js",
        "src/onboard.js",
        "src/hud.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.duolingo.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "midas@dredsgg",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/DredsGG/midas/main/firefox/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
